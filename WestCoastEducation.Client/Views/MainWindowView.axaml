<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:WestCoastEducation.Client.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WestCoastEducation.Client.Views.MainWindowView"
        x:DataType="viewModels:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WestCoastEducationClient"
        
        >

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <viewModels:MainWindowViewModel />
    </Design.DataContext>
    
    

<StackPanel>
    
    <Grid ColumnDefinitions="Auto, *">

        <StackPanel Background="{DynamicResource Surface}" VerticalAlignment="Stretch">
            <TextBlock Text="Westcoast Education" FontSize="18" HorizontalAlignment="Center" Padding="0,10,0,20" Foreground="{DynamicResource Primary}"/>
            <Button HorizontalAlignment="Stretch" Margin="5,2" Command="{Binding NavigateToStaffPageCommand}">
                <TextBlock HorizontalAlignment="Center" Text="Staff"></TextBlock>
            </Button>
            <Button HorizontalAlignment="Stretch" Margin="5,2" Command="{Binding NavigateToStudentsPageCommand}">
                <TextBlock HorizontalAlignment="Center" Text="Students"></TextBlock>
            </Button>
            <Button HorizontalAlignment="Stretch" Margin="5,2" Command="{Binding NavigateToCoursesPageCommand}">
                <TextBlock HorizontalAlignment="Center" Text="Courses" />
            </Button>
        </StackPanel>
        <UserControl Grid.Column="1" Content="{Binding CurrentPage}"  ></UserControl>
    </Grid>
</StackPanel>

</Window>