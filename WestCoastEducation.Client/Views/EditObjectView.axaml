<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:WestCoastEducation.Client.ViewModels"
             xmlns:global="clr-namespace:"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastEducation.Client.Views.EditObjectView"
             x:DataType="viewModels:EditObjectViewModel"
             >
    <StackPanel>
        <Label Content="{Binding PageTitle}"></Label>
    <ItemsControl ItemsSource="{Binding Fields}">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="global:EditableField">
                <StackPanel>
                    <Label Content="{Binding Label}"></Label>
                    <TextBox Text="{Binding Value}"></TextBox>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
        <Button Command="{Binding SaveCommand}" Content="Spara"></Button>
    </StackPanel>
</UserControl>
